# Supabase — the ONLY external backend. Copy to .env.local and fill in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web push — the VAPID public key only. The private key is the send-push function
# secret VAPID_PRIVATE_KEY and never goes in a VITE_ variable or a committed file.
VITE_VAPID_PUBLIC_KEY=
